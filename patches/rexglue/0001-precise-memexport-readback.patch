+bool D3D12CommandProcessor::IssueDraw_MemexportPreciseSnapshot(uint32_t total_size) {
+  if (!total_size || memexport_ranges_.empty()) {
+    return false;
+  }
+  // One buffer for both copies: "before" at 0, "after" at total_size (requested once so a resize can't drop the
+  // first copy).
+  ID3D12Resource* readback_buffer = RequestReadbackBuffer(total_size * 2);
+  if (!readback_buffer) {
+    return false;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  uint32_t readback_buffer_offset = 0;
+  for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+    deferred_command_list_.D3DCopyBufferRegion(readback_buffer, readback_buffer_offset, shared_memory_buffer,
+                                               memexport_range.base_address_dwords << 2,
+                                               memexport_range.size_bytes);
+    readback_buffer_offset += memexport_range.size_bytes;
+  }
+  return true;
+}
+
+bool D3D12CommandProcessor::IssueDraw_MemexportReadbackPrecisePath(uint32_t total_size) {
+  ID3D12Resource* readback_buffer = RequestReadbackBuffer(total_size * 2);
+  if (!readback_buffer) {
+    return true;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  ID3D12Resource* shared_memory_buffer = shared_memory_->GetBuffer();
+  uint32_t readback_buffer_offset = total_size;
+  for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+    deferred_command_list_.D3DCopyBufferRegion(readback_buffer, readback_buffer_offset, shared_memory_buffer,
+                                               memexport_range.base_address_dwords << 2,
+                                               memexport_range.size_bytes);
+    readback_buffer_offset += memexport_range.size_bytes;
+  }
+
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return true;
+  }
+
+  D3D12_RANGE readback_range = {};
+  readback_range.Begin = 0;
+  readback_range.End = total_size * 2;
+  void* readback_mapping = nullptr;
+  if (FAILED(readback_buffer->Map(0, &readback_range, &readback_mapping))) {
+    return true;
+  }
+
+  // Write only what the draw changed: everything else in the declared range may be CPU data the GPU copy doesn't
+  // have the latest version of.
+  const uint8_t* before = reinterpret_cast<const uint8_t*>(readback_mapping);
+  const uint8_t* after = before + total_size;
+  for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+    uint8_t* guest = memory_->TranslatePhysical(memexport_range.base_address_dwords << 2);
+    uint32_t size = memexport_range.size_bytes;
+    uint32_t i = 0;
+    for (; i + 8 <= size; i += 8) {
+      uint64_t b, a;
+      std::memcpy(&b, before + i, 8);
+      std::memcpy(&a, after + i, 8);
+      if (a == b) {
+        continue;
+      }
+      for (uint32_t j = i; j < i + 8; ++j) {
+        if (after[j] != before[j]) {
+          guest[j] = after[j];
+        }
+      }
+    }
+    for (; i < size; ++i) {
+      if (after[i] != before[i]) {
+        guest[i] = after[i];
+      }
+    }
+    before += size;
+    after += size;
+  }
+
+  D3D12_RANGE readback_write_range = {};
+  readback_buffer->Unmap(0, &readback_write_range);
+  return true;
+}
