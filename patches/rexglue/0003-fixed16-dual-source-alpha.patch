+bool PipelineCache::UsesFixed16DualSourceAlpha(const Shader& pixel_shader) const {
+  if (render_target_cache_.GetPath() != RenderTargetCache::Path::kHostRenderTargets ||
+      render_target_cache_.IsFixed16TruncatedToMinus1To1() || pixel_shader.writes_color_targets() != 0b0001) {
+    return false;
+  }
+  const auto& regs = register_file_;
+  const xenos::ColorRenderTargetFormat format = regs.Get<reg::RB_COLOR_INFO>().color_format;
+  if (format != xenos::ColorRenderTargetFormat::k_16_16 &&
+      format != xenos::ColorRenderTargetFormat::k_16_16_16_16) {
+    return false;
+  }
+  if (!(regs[XE_GPU_REG_RB_COLOR_MASK] & 0xF)) {
+    return false;
+  }
+  // SRC_ALPHA / ONE_MINUS_SRC_ALPHA (6, 7), and SRC_COLOR / ONE_MINUS_SRC_COLOR (4, 5) for alpha, which map to them.
+  auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[0]);
+  auto alpha_factor = [](uint32_t f, bool for_alpha) { return f == 6 || f == 7 || (for_alpha && (f == 4 || f == 5)); };
+  return alpha_factor(uint32_t(blend.color_srcblend), false) || alpha_factor(uint32_t(blend.color_destblend), false) ||
+         alpha_factor(uint32_t(blend.alpha_srcblend), true) || alpha_factor(uint32_t(blend.alpha_destblend), true);
+}
