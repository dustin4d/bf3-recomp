+void CommandProcessor::OnGuestSwapSubmitted() {
+  uint64_t submitted = swaps_submitted_.fetch_add(1, std::memory_order_relaxed) + 1;
+  uint64_t executed = swaps_executed_.load(std::memory_order_acquire);
+  uint32_t backlog = submitted > executed ? uint32_t(submitted - executed) : 0;
+  uint32_t seen_max = swap_backlog_max_.load(std::memory_order_relaxed);
+  while (backlog > seen_max && !swap_backlog_max_.compare_exchange_weak(seen_max, backlog)) {
+  }
+  int32_t max_ahead = REXCVAR_GET(gpu_max_frames_ahead);
+  if (max_ahead <= 0 || backlog <= uint32_t(max_ahead) || !worker_running_) {
+    return;
+  }
+  // This frame's swap isn't visible to the command processor yet (the guest advances the write pointer after
+  // VdSwap), so wait only for the earlier ones; bounded so a GPU waiting on this thread can't deadlock.
+  auto start = std::chrono::steady_clock::now();
+  while (worker_running_ &&
+         submitted - swaps_executed_.load(std::memory_order_acquire) > uint64_t(max_ahead) &&
+         std::chrono::steady_clock::now() - start < std::chrono::milliseconds(250)) {
+    rex::thread::Wait(swap_executed_event_.get(), false, std::chrono::milliseconds(10));
+  }
+  swap_wait_us_.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                       std::chrono::steady_clock::now() - start)
+                                       .count()),
+                          std::memory_order_relaxed);
+}
