+void CommandProcessor::LateWriteCheck() {
+  if (!late_write_frames_) {
+    if (REXCVAR_GET(gpu_late_write_check) > 0) {
+      late_write_frames_ = uint32_t(REXCVAR_GET(gpu_late_write_check));
+      REXCVAR_SET(gpu_late_write_check, 0);
+    }
+    late_write_ranges_.clear();
+    return;
+  }
+  uint32_t changed = 0, changed_ib = 0, changed_bytes = 0;
+  std::string where;
+  for (const LateWriteRange& range : late_write_ranges_) {
+    const uint8_t* data = memory_->TranslatePhysical<const uint8_t*>(range.address);
+    if (XXH3_64bits(data, range.size) == range.hash) {
+      continue;
+    }
+    ++changed;
+    changed_ib += range.indirect;
+    changed_bytes += range.size;
+    if (changed <= 6) {
+      where += fmt::format(" {}{:08X}+{:X}", range.indirect ? "IB " : "K ", range.address, range.size);
+    }
+  }
+  REXGPU_INFO("late writes: {} of {} ranges read this frame changed afterwards ({} indirect buffers, {} bytes):{}",
+              changed, late_write_ranges_.size(), changed_ib, changed_bytes, where);
+  late_write_ranges_.clear();
+  --late_write_frames_;
+}
