+void D3D12CommandProcessor::FrameTraceOnSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                                             uint32_t frontbuffer_height) {
+  int32_t trace_at = REXCVAR_GET(gpu_frame_trace_at);
+  if (trace_at <= 0) {
+    return;
+  }
+  uint64_t now_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                 std::chrono::steady_clock::now().time_since_epoch())
+                                 .count());
+  if (!frame_trace_start_ms_) {
+    frame_trace_start_ms_ = now_ms;
+    frame_trace_next_ms_ = now_ms + uint64_t(trace_at) * 1000;
+  }
+  ++frame_trace_swaps_;
+  if (frame_trace_active_) {
+    REXGPU_INFO("ftrace swap {} fb {:08X} {}x{} draws {} resolves {}", frame_trace_swaps_, frontbuffer_ptr,
+                frontbuffer_width, frontbuffer_height, frame_trace_draw_, frame_trace_resolve_);
+    if (--frame_trace_frames_ == 0) {
+      frame_trace_active_ = false;
+      REXGPU_INFO("ftrace end");
+    }
+  }
+  if (!frame_trace_active_ && now_ms >= frame_trace_next_ms_) {
+    int32_t every = REXCVAR_GET(gpu_frame_trace_every);
+    frame_trace_next_ms_ = every > 0 ? now_ms + uint64_t(every) * 1000 : UINT64_MAX;
+    frame_trace_active_ = true;
+    frame_trace_frames_ = uint32_t(std::max(REXCVAR_GET(gpu_frame_trace_frames), 1));
+    frame_trace_draw_ = 0;
+    frame_trace_resolve_ = 0;
+    REXGPU_INFO("ftrace begin at swap {} (+{} ms)", frame_trace_swaps_, now_ms - frame_trace_start_ms_);
+    std::string ranges = REXCVAR_GET(gpu_frame_trace_ranges);
+    frame_trace_resolve_ = 9000;
+    for (size_t pos = 0; pos < ranges.size();) {
+      size_t end = ranges.find(',', pos);
+      std::string item = ranges.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+      size_t colon = item.find(':');
+      if (colon != std::string::npos) {
+        uint32_t address = uint32_t(std::stoul(item.substr(0, colon), nullptr, 16)) & 0x1FFFFFFF;
+        uint32_t length = uint32_t(std::stoul(item.substr(colon + 1), nullptr, 16));
+        FrameTraceDumpRange(address, length);
+        ++frame_trace_resolve_;
+      }
+      pos = end == std::string::npos ? ranges.size() : end + 1;
+    }
+    frame_trace_resolve_ = 0;
+  }
+}
+
+void D3D12CommandProcessor::FrameTraceDumpRange(uint32_t address, uint32_t length) {
+  const std::string& dir = REXCVAR_GET(gpu_frame_trace_dir);
+  if (dir.empty() || !length || length > (64u << 20)) {
+    return;
+  }
+  ID3D12Resource* readback_buffer = RequestReadbackBuffer(length);
+  if (!readback_buffer) {
+    return;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(readback_buffer, 0, shared_memory_->GetBuffer(), address, length);
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return;
+  }
+  D3D12_RANGE readback_range = {0, length};
+  void* mapping = nullptr;
+  if (FAILED(readback_buffer->Map(0, &readback_range, &mapping))) {
+    return;
+  }
+  char name[96];
+  std::snprintf(name, sizeof(name), "s%05u_r%03u_%08X.bin", frame_trace_swaps_, frame_trace_resolve_, address);
+  std::filesystem::path path = std::filesystem::path(dir) / name;
+  if (FILE* f = std::fopen(path.string().c_str(), "wb")) {
+    std::fwrite(mapping, 1, length, f);
+    std::fclose(f);
+  }
+  D3D12_RANGE write_range = {};
+  readback_buffer->Unmap(0, &write_range);
+}
+
 bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint32_t index_count,
                                       IndexBufferInfo* index_buffer_info,
                                       bool major_mode_explicit) {
+  if (!frame_trace_active_) {
+    return IssueDrawInner(primitive_type, index_count, index_buffer_info, major_mode_explicit);
+  }
+  const RegisterFile& regs = *register_file_;
+  bool is_copy = regs.Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy;
+  uint32_t index = is_copy ? frame_trace_resolve_ : frame_trace_draw_;
+  if (is_copy) {
+    REXGPU_INFO("ftrace R{} ctl {:08X} destinfo {:08X} base {:08X} pitch {:08X} surf {:08X} color0 {:08X} "
+                "depth {:08X} clear {:08X}/{:08X}",
+                index, regs[XE_GPU_REG_RB_COPY_CONTROL], regs[XE_GPU_REG_RB_COPY_DEST_INFO],
+                regs[XE_GPU_REG_RB_COPY_DEST_BASE], regs[XE_GPU_REG_RB_COPY_DEST_PITCH],
+                regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_RB_COLOR_INFO], regs[XE_GPU_REG_RB_DEPTH_INFO],
+                regs[XE_GPU_REG_RB_COLOR_CLEAR], regs[XE_GPU_REG_RB_DEPTH_CLEAR]);
+  }
+  frame_trace_note_ = nullptr;
+  bool result = IssueDrawInner(primitive_type, index_count, index_buffer_info, major_mode_explicit);
+  if (is_copy) {
+    ++frame_trace_resolve_;
+    return result;
+  }
+  ++frame_trace_draw_;
+  auto vs = static_cast<D3D12Shader*>(active_vertex_shader());
+  auto ps = static_cast<D3D12Shader*>(active_pixel_shader());
+  REXGPU_INFO("ftrace D{} {} prim {} n {} vs {:016X} ps {:016X} mode {:08X} surf {:08X} c {:08X} {:08X} {:08X} "
+              "{:08X} d {:08X} mask {:08X} blend {:08X} dctl {:08X} {}",
+              index, result ? "ok" : "FAIL", uint32_t(primitive_type), index_count,
+              vs ? vs->ucode_data_hash() : 0, ps ? ps->ucode_data_hash() : 0, regs[XE_GPU_REG_RB_MODECONTROL],
+              regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_RB_COLOR_INFO], regs[XE_GPU_REG_RB_COLOR1_INFO],
+              regs[XE_GPU_REG_RB_COLOR2_INFO], regs[XE_GPU_REG_RB_COLOR3_INFO], regs[XE_GPU_REG_RB_DEPTH_INFO],
+              regs[XE_GPU_REG_RB_COLOR_MASK], regs[XE_GPU_REG_RB_BLENDCONTROL0], regs[XE_GPU_REG_RB_DEPTHCONTROL],
+              frame_trace_note_ ? frame_trace_note_ : "");
+  if (primitive_type == xenos::PrimitiveType::kRectangleList) {
+    // Full-screen passes: log the first pixel shader float constants.
+    for (uint32_t i : {0u, 2u, 4u, 6u, 8u, 10u, 12u, 14u, 252u, 254u}) {
+      const float* k = reinterpret_cast<const float*>(&regs[XE_GPU_REG_SHADER_CONSTANT_256_X + i * 4]);
+      REXGPU_INFO("ftrace   c{} {} {} {} {} | {} {} {} {}", i, k[0], k[1], k[2], k[3], k[4], k[5], k[6], k[7]);
+    }
+  }
+  uint32_t used_textures = (vs ? vs->GetUsedTextureMaskAfterTranslation() : 0) |
+                           (ps ? ps->GetUsedTextureMaskAfterTranslation() : 0);
+  for (uint32_t i = 0; i < 32; ++i) {
+    if (used_textures & (1u << i)) {
+      const uint32_t* f = &regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + i * 6];
+      REXGPU_INFO("ftrace   tex{} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}", i, f[0], f[1], f[2], f[3], f[4],
+                  f[5]);
+    }
+  }
+  return result;
+}
