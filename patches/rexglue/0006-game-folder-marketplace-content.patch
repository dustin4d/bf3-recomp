+std::filesystem::path ContentManager::ResolveGameContentRoot(uint32_t title_id) {
+  auto game_data_root = kernel_state_->emulator()->game_data_root();
+  if (game_data_root.empty()) {
+    return {};
+  }
+  if (title_id == kCurrentlyRunningTitleId) {
+    title_id = kernel_state_->title_id();
+  }
+  auto title_id_str = fmt::format("{:08X}", title_id);
+  auto content_type_str = fmt::format("{:08X}", uint32_t(XContentType::kMarketplaceContent));
+  return game_data_root / "Content" / "0000000000000000" / title_id_str / content_type_str;
 }
 
