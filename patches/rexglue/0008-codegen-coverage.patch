+//=============================================================================
+// Coverage
+//=============================================================================
+
+// With the codegen option `coverage`, every function starts with
+// REX_COVERAGE_HIT(its guest address). It stores 1 into this module's hit byte
+// for that address (one byte per instruction slot of the code range) only when
+// the build defines REX_COVERAGE; otherwise it compiles to nothing. The byte is
+// read before it is written: hot functions run on every thread, and a store of
+// an unchanged value would still bounce its cache line between cores on every call.
+#if defined(REX_CONFIG_COVERAGE) && defined(REX_COVERAGE)
+extern "C" uint8_t rex_coverage_hits[];
+#define REX_COVERAGE_HIT(addr)                                                   \
+  do {                                                                           \
+    if ((u32)((addr) - REX_CODE_BASE) < REX_CODE_SIZE) {                         \
+      volatile uint8_t* rex_hit_ = &rex_coverage_hits[(u32)((addr) - REX_CODE_BASE) >> 2]; \
+      if (__builtin_expect(*rex_hit_ == 0, 0))                                   \
+        *rex_hit_ = 1;                                                           \
+    }                                                                            \
+  } while (0)
+#else
+#define REX_COVERAGE_HIT(addr) ((void)0)
+#endif
+
 //=============================================================================
 // Memory Access
 //=============================================================================
